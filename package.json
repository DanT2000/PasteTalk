{
  "name": "pastetalk",
  "version": "2.13.0",
  "description": "Голос в текст по горячей клавише. Локально, без интернета.",
  "author": "DanT2000",
  "license": "MIT",
  "private": true,
  "main": "app/main/index.js",
  "scripts": {
    "start": "node scripts/dev.mjs",
    "dev": "node scripts/dev.mjs --dev",
