# Личное — сюда сложены ключи и доступы к серверу.
# Файл никогда не должен попасть в репозиторий.
info.txt

# Сборка и зависимости
node_modules/
dist/
release/
out/

# Окружение движка и скачанные модели
engine/.venv/
engine/.models/
engine/build/
engine/dist/
engine/*.spec
__pycache__/
*.pyc

# Собранный движок — 236 МБ бинарников, они уезжают в релиз, а не в код.
# Собирается командой: npm run engine:build
build/engine/

# Иконки лежат в репозитории намеренно: они нужны сборщику установщика,
# и на них ссылается README. Пересобрать — scripts/make-icon.ps1

# База сервера: в ней счётчики конкретных людей, ей место на сервере,
# а не в репозитории.
server/data/

# Локальное
.env
.env.*
*.log
scratch/

# Записи для проверок — они личные и в репозиторий не идут.
*.mp3
*.wav
*.m4a
*.ogg
samples/

# Снимки для README нужны в репозитории.
!docs/*.png
